# Copia este archivo como ".env" para desarrollo local si quieres
# probar contra PostgreSQL en vez del SQLite por defecto.
# En Render, estas variables se configuran desde el panel del servicio
# (o automáticamente si usas render.yaml), NO se sube un archivo .env.

# Cadena de conexión a la base de datos.
# Si se omite, la app usa SQLite local (./mercado_viva.db) automáticamente.
# DATABASE_URL=postgresql://usuario:clave@host:5432/mercado_viva

# Clave secreta para firmar los tokens JWT. Genera una distinta en producción.
JWT_SECRET=cambia-esta-clave-en-produccion

# Dominio permitido para CORS. En producción, usa el dominio real del frontend.
ALLOWED_ORIGINS=*
